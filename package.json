{
  "name": "@captcha-la/node",
  "version": "1.0.0",
  "description": "Official CaptchaLa server-side SDK for Node.js: validate CAPTCHA pass tokens, issue server tokens, moderate content. Zero dependencies.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./express": {
      "import": { "types": "./dist/esm/express.d.ts", "default": "./dist/esm/express.js" },
      "require": { "types": "./dist/cjs/express.d.ts", "default": "./dist/cjs/express.js" }
    },
    "./next": {
      "import": { "types": "./dist/esm/next.d.ts", "default": "./dist/esm/next.js" },
      "require": { "types": "./dist/cjs/next.d.ts", "default": "./dist/cjs/next.js" }
    },
    "./fastify": {
      "import": { "types": "./dist/esm/fastify.d.ts", "default": "./dist/esm/fastify.js" },
      "require": { "types": "./dist/cjs/fastify.d.ts", "default": "./dist/cjs/fastify.js" }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.cjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "~5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Captcha-La/captchala-node.git"
  },
  "bugs": {
    "url": "https://github.com/Captcha-La/captchala-node/issues"
  },
  "homepage": "https://docs.captcha.la/sdk/server-node",
  "keywords": [
    "captcha",
    "captchala",
    "bot-protection",
    "security",
    "verification",
    "express",
    "nextjs",
    "fastify"
  ],
  "author": "CaptchaLa <supply@captcha.la>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
